<view class="page">

  <!-- 词库选择（可多选） -->
  <view class="card">
    <view class="section-title">📚 生词库（可多选）</view>
    <view class="muted line">已选 {{bankCount}} 套，合并共 {{total}} 词（重复的词自动去重，只学一次）。</view>
    <view wx:for="{{bankGroups}}" wx:key="group" class="bank-group">
      <view class="bank-group-title">{{item.group}}</view>
      <view
        wx:for="{{item.items}}"
        wx:for-item="b"
        wx:key="id"
        class="bank-opt {{b.checked ? 'active' : ''}} {{b.available ? '' : 'disabled'}}"
        data-id="{{b.id}}"
        bindtap="toggleBank">
        <view class="bank-name">
          <text class="bank-check">{{b.checked ? "☑" : "☐"}}</text>{{b.name}}
        </view>
        <view class="muted">{{b.desc}}</view>
      </view>
    </view>
    <view class="muted" style="margin-top:16rpx">取消勾选不会删进度：那套词的掌握情况仍保留着，重新勾上就接着背。至少要留一套。</view>
  </view>

  <!-- 每周新词量 -->
  <view class="card">
    <view class="section-title">🎯 每周新单词目标</view>
    <view class="muted" style="margin-bottom:20rpx">平均每天 {{weeklyNew / 7}} 个新词，系统自动安排复习</view>
    <view class="week-grid">
      <view
        wx:for="{{weekOptions}}" wx:key="*this"
        data-v="{{item}}" bindtap="setWeekly"
        class="week-opt {{weeklyNew === item ? 'active' : ''}}">
        {{item}} 个
      </view>
    </view>
  </view>

  <!-- 今日加点量 -->
  <view class="card">
    <view class="section-title">⚡ 今日加点量</view>
    <view class="muted" style="margin-bottom:20rpx">今天状态好？临时多背 5 个新词 + 多玩一轮消消乐。明天自动恢复正常节奏，不影响每周目标。{{todayExtra > 0 ? "今天已加 " + todayExtra + " 词" : ""}}</view>
    <view class="btn-soft" bindtap="addExtra">➕ 今天多背 5 个单词</view>
  </view>

  <!-- 排期自检：仅在检测到异常时出现 -->
  <view wx:if="{{schedAhead > 0 || aheadBy > 0}}" class="card">
    <view class="section-title">🧭 排期自检</view>
    <view class="muted line" wx:if="{{schedAhead > 0}}">有 {{schedAhead}} 个单词的复习日期被排到 30 天以后，这通常是之前改过手机系统时间留下的，会让「今日」长期显示没有任务。</view>
    <view class="muted line" wx:if="{{aheadBy > 0}}">已学词数比计划进度超前 {{aheadBy}} 个，新词额度会被抵扣（这就是「多背 5 个」点了没反应的原因）。</view>
    <view class="muted line">先点「⚡ 今日加点量」即可照常多背；想让复习也恢复正常，用下面的按钮把排期拉回。</view>
    <view wx:if="{{schedAhead > 0}}" class="btn-soft" bindtap="fixSchedule">🔧 把超前的复习排期拉回今天</view>
  </view>

  <!-- 数据统计 -->
  <view class="card">
    <view class="section-title">📊 学习数据</view>
    <view class="data-row"><text>🔥 当前连续打卡</text><text class="dv">{{streak}} 天</text></view>
    <view class="data-row"><text>🏅 最长连续打卡</text><text class="dv">{{bestStreak}} 天</text></view>
    <view class="data-row"><text>📅 累计学习天数</text><text class="dv">{{dayCount}} 天</text></view>
    <view class="data-row"><text>📖 已学单词</text><text class="dv">{{learned}} / {{total}}</text></view>
    <view class="data-row"><text>🎓 已毕业单词</text><text class="dv">{{graduated}}</text></view>
  </view>

  <!-- 遗忘曲线说明 -->
  <view class="card">
    <view class="section-title">🧠 背词原理（艾宾浩斯遗忘曲线）</view>
    <view class="muted line">每个新单词会在学后第 <text class="hl">1、2、4、7、15、30</text> 天自动安排复习。</view>
    <view class="muted line">答对 → 进入下一个更长的间隔；答错 → 明天优先复习。全部节点通过即「毕业」🎓。</view>
    <view class="muted line">每天打开先完成到期复习，再学新单词。</view>
  </view>

  <!-- 进度备份 -->
  <view class="card">
    <view class="section-title">💾 进度备份</view>
    <view class="muted line">学习进度只保存在这台设备上（不联网、不上传）。换手机、或微信清缓存之前，先「导出备份」发到自己的微信里存着；换到新设备后「导入备份」即可接着背。</view>
    <view class="backup-btns">
      <view class="btn-soft" bindtap="exportProgress">📤 导出备份</view>
      <view class="btn-soft" bindtap="openCopyBackup">📋 复制文本</view>
    </view>
    <view class="backup-btns">
      <view class="btn-soft" bindtap="openImport">📥 导入备份</view>
    </view>
  </view>

  <!-- 重置 -->
  <view class="card">
    <view class="section-title">⚠️ 重新开始</view>
    <view class="muted" style="margin-bottom:20rpx">清空这台设备上的全部学习进度（单词记录、打卡、统计），从第一个单词重新开始。此操作不可恢复，建议先导出备份。</view>
    <view class="btn-danger" bindtap="openReset">🗑 重置全部进度</view>
  </view>

  <!-- 备份面板：导出（文本兜底）/ 导入（粘贴） -->
  <view wx:if="{{backupPanel}}" class="mask" bindtap="closeBackup">
    <view class="dialog pop" catchtap="noop">
      <view class="page-title" style="font-size:38rpx">{{backupMode === 'export' ? '导出进度备份' : '导入进度备份'}}</view>
      <view class="muted" style="margin:20rpx 0">
        {{backupMode === 'export' ? '这串文字就是全部进度（已学单词、掌握度、复习排期、打卡天数）。长按全选复制，粘贴到微信「文件传输助手」或收藏里保存好。' : '在微信里打开之前保存的备份，长按全选复制，粘贴到下面，点「导入并覆盖」即可恢复。'}}
      </view>
      <textarea
        class="backup-text"
        value="{{backupMode === 'export' ? backupText : ''}}"
        placeholder="{{backupMode === 'import' ? '在此粘贴备份内容' : ''}}"
        bindinput="onBackupInput"
        maxlength="-1"
        show-confirm-bar="{{false}}"
      ></textarea>
      <view class="dialog-btns">
        <view class="btn-soft" bindtap="closeBackup">关闭</view>
        <view wx:if="{{backupMode === 'export'}}" class="btn-soft" bindtap="copyBackup">📋 复制全部</view>
        <view wx:if="{{backupMode === 'import'}}" class="btn-danger" bindtap="doImport">导入并覆盖</view>
      </view>
    </view>
  </view>

  <!-- 重置确认弹窗 -->
  <view wx:if="{{confirmReset}}" class="mask" bindtap="cancelReset">
    <view class="dialog pop" catchtap="noop">
      <view class="page-title" style="font-size:38rpx">确认重置？</view>
      <view class="muted" style="margin:20rpx 0">将清空全部 {{learned}} 个已学单词与打卡记录。请输入「重置」二字确认：</view>
      <input class="reset-input" placeholder="输入：重置" value="{{resetText}}" bindinput="onResetInput" />
      <view class="dialog-btns">
        <view class="btn-soft" bindtap="cancelReset">取消</view>
        <view class="btn-danger" bindtap="doReset">确认重置</view>
      </view>
    </view>
  </view>
</view>
