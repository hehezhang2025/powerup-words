.page { padding-bottom: 60rpx; }

.week-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.week-opt {
  width: 30%;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #6B5D4F;
  background: #F7EDD7;
  border-radius: 20rpx;
  padding: 24rpx 0;
}
.week-opt.active {
  color: #fff;
  background: linear-gradient(135deg, #FF9A3D, #FF7A59);
  box-shadow: 0 6rpx 16rpx rgba(232, 106, 43, 0.3);
}

/* 开关（单元内打乱） */
.switch-row { display: flex; align-items: center; gap: 24rpx; }
.switch-label { flex: 1; }
.switch-main { font-size: 30rpx; font-weight: 700; color: #4A4036; margin-bottom: 6rpx; }
.switch {
  flex: none;
  width: 96rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #E3DACB;
  padding: 6rpx;
  box-sizing: border-box;
  transition: background 0.2s;
}
.switch.on { background: #FF9A3D; }
.switch-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s;
}
.switch.on .switch-dot { transform: translateX(44rpx); }

/* 自定义每周目标 / 撤销加量行 */
.week-custom { display: flex; align-items: center; gap: 20rpx; margin-top: 20rpx; }
.week-input {
  flex: 1;
  background: #F7F1E4;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  color: #4A4036;
}
.week-save { flex: none; width: 160rpx; margin: 0; }

.data-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  font-size: 30rpx;
  border-bottom: 2rpx dashed #F0E4CC;
}
.data-row:last-child { border-bottom: none; }
.dv { font-weight: 800; color: #FF7A59; }

.line { margin-bottom: 12rpx; line-height: 1.6; }
.hl { color: #FF7A59; font-weight: 700; }

.mask {
  position: fixed;
  inset: 0;
  background: rgba(60, 40, 20, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.dialog {
  width: 78vw;
  background: #fff;
  border-radius: 32rpx;
  padding: 44rpx 40rpx;
}
.reset-input {
  background: #F7F1E4;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 34rpx;
  margin: 16rpx 0 32rpx;
}
.dialog-btns { display: flex; gap: 24rpx; }
.dialog-btns > view { flex: 1; }

/* 词库选择 */
.bank-group { margin-top: 20rpx; }
.bank-group-title { font-size: 26rpx; color: #9C8E7E; margin-bottom: 12rpx; }
.bank-opt {
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: #FFFDF6;
  border: 3rpx solid #EBDFC5;
  margin-bottom: 14rpx;
}
.bank-opt.active { border-color: #FF8A3D; background: #FFF1E0; }
.bank-opt.disabled { opacity: 0.5; }
.bank-name { font-size: 30rpx; font-weight: 700; color: #4A4036; }
.bank-check { margin-right: 10rpx; color: #FF8A3D; }

/* 进度备份 */
.backup-btns { display: flex; gap: 24rpx; margin-top: 8rpx; }
.backup-btns > view { flex: 1; }
.backup-text {
  width: 100%;
  height: 320rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6B5D4F;
  background: #F7F1E4;
  border: 2rpx solid #EFD9B4;
  border-radius: 16rpx;
  word-break: break-all;
}
