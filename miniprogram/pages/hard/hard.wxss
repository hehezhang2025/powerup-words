.page { padding-bottom: 60rpx; }

.list-card { padding: 8rpx 32rpx; }
.word-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx dashed #F0E4CC;
}
.word-row:last-child { border-bottom: none; }
.we { font-size: 36rpx; font-weight: 700; color: #2F6FED; margin-right: 18rpx; }
.wz { font-size: 30rpx; color: #6B5D4F; }
.word-side { text-align: right; min-width: 220rpx; }
.small { font-size: 22rpx; }
.hl { color: #FF7A59; font-weight: 700; }
.badge-hard {
  display: inline-block;
  font-size: 24rpx;
  color: #E5484D;
  background: #FFE9EA;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  margin-bottom: 8rpx;
}
