.page { padding: 24rpx; }

.progress-line { display: flex; justify-content: center; gap: 16rpx; margin: 20rpx 0 12rpx; }
.dot {
  width: 22rpx; height: 22rpx; border-radius: 50%;
  background: #EBDFC5;
}
.dot.done { background: #6BCB77; }
.dot.cur { background: #FF8A3D; transform: scale(1.3); }
.step-text { margin-bottom: 30rpx; }

.word-card {
  background: #fff;
  border-radius: 36rpx;
  min-height: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(180, 140, 60, 0.15);
  padding: 60rpx 40rpx;
}
.en { font-size: 76rpx; font-weight: 800; color: #4A4036; letter-spacing: 2rpx; }
.speak-btn {
  margin-top: 36rpx;
  font-size: 34rpx;
  color: #4D96FF;
  background: #E7F0FF;
  border-radius: 999rpx;
  padding: 16rpx 44rpx;
}
.speak-btn:active { background: #D3E4FF; }
.zh { margin-top: 44rpx; font-size: 52rpx; font-weight: 700; color: #FF7A59; }
.hint { margin-top: 44rpx; font-size: 28rpx; color: #B9A98F; }

.next-btn { margin: 50rpx 24rpx 0; }
